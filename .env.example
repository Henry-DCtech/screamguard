# Copy to `.env` and fill in. Variables MUST be prefixed with EXPO_PUBLIC_ to be
# readable in the app at runtime.

# Backend base URL — enables on-server ML scream detection (POST /api/inference)
# and SMS/push alert dispatch (POST /api/alerts).
# Leave unset to run in offline "loudness mode" (no ML, no SMS — alerts are still
# logged to Supabase and shown in History).
#
# Examples:
#   Android emulator → http://10.0.2.2:8000
#   iOS simulator    → http://localhost:8000
#   Physical device  → http://<your-computer-LAN-IP>:8000  (e.g. http://192.168.1.20:8000)
#   Deployed         → https://your-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=
