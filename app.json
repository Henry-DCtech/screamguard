{
  "expo": {
    "name": "ScreamGuard",
    "slug": "screamguard",
    "scheme": "screamdetectionapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B14"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "ScreamGuard monitors audio to detect screams and send emergency alerts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF3B4E"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ScreamGuard needs location access to attach your position to emergency alerts."
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.screamguard.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ScreamGuard monitors audio to detect screams and send emergency alerts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ScreamGuard attaches your location to emergency alerts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B14"
      },
      "package": "com.screamguard.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
